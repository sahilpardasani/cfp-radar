# ---- Free LLM provider for the recommender + reference-check agent ----
# Choose one: "groq" (default) or "nvidia". Both expose an OpenAI-compatible API.
LLM_PROVIDER=groq

# Groq: get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# NVIDIA (integrate.api.nvidia.com): get a key at https://build.nvidia.com
# Required for the NVIDIA models in the Paper -> Venue model dropdown
# (GLM 5.2, MiniMax-M3, DeepSeek V4 Pro, Gemma 4, Qwen 3.5, Mistral Large 3, Llama 3.3 70B, GPT-OSS 120B).
# NOTE: never commit a real key. If you pasted one anywhere public, rotate it.
NVIDIA_API_KEY=

# Model id. The default is the current Groq Qwen deployment requested for CFP Radar.
# NVIDIA examples: meta/llama-3.1-8b-instruct, meta/llama-3.1-70b-instruct
LLM_MODEL=qwen/qwen3.8-27b

# Optional: override endpoints (defaults are set in lib/llm.js)
# LLM_BASE_URL=

# Maximum time to wait for an LLM response (milliseconds)
LLM_TIMEOUT_MS=180000
# Custom LLM endpoints are ignored unless explicitly enabled. Keep this off unless
# you trust the HTTPS endpoint because the configured provider key is sent to it.
ALLOW_CUSTOM_LLM_BASE_URL=0
# Optional secret for administrative batch API operations. Scheduled scripts call
# the underlying modules directly and do not need this value.
PIPELINE_ADMIN_TOKEN=

# ---- Related papers and venue history ----
# Enabled by default. Set to 0 for an immediate rollback that removes history
# links and makes the new APIs/pages unavailable without affecting CFP cards.
VENUE_HISTORY_ENABLED=1

# Optional managed PostgreSQL mirror (recommended for multi-instance Render).
# Without DATABASE_URL the verified data/venue-history.json snapshot is used.
DATABASE_URL=
DATABASE_SSL=1
DATABASE_POOL_MAX=5
# Optional private CA. Keep as one line with literal \\n characters.
DATABASE_CA_CERT=

# Optional metadata enrichment. DBLP identity and paper membership work without
# this key; OpenAlex adds abstracts, citation counts, topics, and OA locations.
OPENALEX_API_KEY=

# Optional Crossref polite-pool contact plus bounded journal-history concurrency.
CROSSREF_MAILTO=
CROSSREF_HISTORY_CONCURRENCY=2
JOURNAL_HISTORY_CONCURRENCY=2

# Live venue comparison fetches official CFP/proceedings pages server-side.
# No search API is required; unreachable or unverified claims are reported as unknown.

# Optional: used by the weekly GitHub Actions legitimacy pass for a second-opinion LLM review.
# Structured Crossref, DBLP, OpenAlex, Crossref-journal, SCImago-page, parent-site,
# and publisher checks work without an LLM key.

# High-volume discovery controls
OPENREVIEW_CONCURRENCY=16
OPENREVIEW_FETCH_TIMEOUT_MS=15000
OPENREVIEW_RETRIES=3
OPENREVIEW_CACHE_TTL_MS=21600000
WATCHLIST_BATCH_SIZE=500
MAX_EXTERNAL_CANDIDATES=100
DISCOVERY_CONCURRENCY=10
DISCOVERY_FETCH_TIMEOUT_MS=12000

# Exhaustive OpenReview mirror. The API collector can inspect hundreds of active groups.
OPENREVIEW_RUNTIME_CONCURRENCY=20
OPENREVIEW_RUNTIME_TIMEOUT_MS=20000
REVIEWER_DISCOVERY_CONCURRENCY=6
OPENREVIEW_RUNTIME_RETRIES=2
OPENREVIEW_RUNTIME_CACHE_MS=300000
OPENREVIEW_INVITATION_BATCH_SIZE=50

# Disabled by default: searching the web separately for every OpenReview group
# is slow and rate-limit prone. Other discovery agents still resolve official CFPs.
OPENREVIEW_SEARCH_OFFICIAL=0

# Book/chapter proposal discovery. Publisher names, domains, memberships, and
# subject scopes live in data/book-call-sources.json rather than core logic.
BOOK_DISCOVERY_CONCURRENCY=5
BOOK_DISCOVERY_RESULTS_PER_QUERY=6


# Cache official CFP resolution for OpenReview venues (24 hours)
OPENREVIEW_OFFICIAL_CACHE_MS=86400000
